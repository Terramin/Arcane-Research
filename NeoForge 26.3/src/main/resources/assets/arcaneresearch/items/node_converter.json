{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "gui"
          }
        }
      },
      {
        "when": "ground",
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "ground"
          }
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "fixed"
          }
        }
      },
      {
        "when": ["thirdperson_righthand", "thirdperson_lefthand"],
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "thirdperson"
          }
        }
      },
      {
        "when": "firstperson_righthand",
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "firstperson_right"
          }
        }
      },
      {
        "when": "firstperson_lefthand",
        "model": {
          "type": "minecraft:special",
          "base": "arcaneresearch:item/node_device_base",
          "model": {
            "type": "arcaneresearch:node_device",
            "kind": "CONVERTER",
            "preset": "firstperson_left"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "arcaneresearch:item/node_device_base",
      "model": {
        "type": "arcaneresearch:node_device",
        "kind": "CONVERTER",
        "preset": "head"
      }
    }
